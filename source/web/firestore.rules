rules_version = '2';
// Lamma security rules: people in an order see each other's food; each edits their own; the host and co-hosts can edit everything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function orderData(oid) { return get(/databases/$(database)/documents/orders/$(oid)).data; }
    function hostOf(oid) { let o = orderData(oid); return o.hostUid == me() || me() in o.get('coHosts', []); }
    function memberOf(oid) { return exists(/databases/$(database)/documents/orders/$(oid)/people/$(me())); }
    function deliveredOrder(oid) { return orderData(oid).get('stage', 'open') == 'delivered'; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid;
      match /joined/{oid} {
        allow read, write: if signedIn() && me() == uid;
      }
      // notifications: only the owner reads them; people in an order can send notes about that order
      match /inbox/{nid} {
        allow read, update, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && request.resource.data.from == me() && request.resource.data.read == false
          && request.resource.data.keys().hasOnly(['type', 'title', 'body', 'orderId', 'from', 'fromName', 'at', 'read', 'amount'])
          && request.resource.data.title is string && request.resource.data.title.size() < 200
          && request.resource.data.get('body', '') is string && request.resource.data.get('body', '').size() < 600
          && (exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)/people/$(me()))
              || orderData(request.resource.data.orderId).hostUid == me());
      }
    }

    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == me();
      allow update, delete: if signedIn() && resource.data.hostUid == me();
    }

    match /menus/{mid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == me();
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update, delete: if signedIn() && resource.data.ownerUid == me();
      match /photos/{pid} {
        allow read: if signedIn();
        allow write: if signedIn() && get(/databases/$(database)/documents/menus/$(mid)).data.ownerUid == me();
      }
    }

    match /orders/{oid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.hostUid == me();
      allow create: if signedIn() && request.resource.data.hostUid == me();
      // the main host does everything; co-hosts too, except changing who the hosts are or deleting the order
      allow update: if signedIn() && (resource.data.hostUid == me() ||
        (me() in resource.data.get('coHosts', []) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostUid', 'coHosts', 'code'])));
      allow delete: if signedIn() && resource.data.hostUid == me();

      match /people/{pid} {
        function isHost() { let o = orderData(oid); return o.hostUid == me() || me() in o.get('coHosts', []); }
        // open: not locked by the host, the deadline (lockAt, in ms) has not passed, not delivered
        function isOpen() {
          let o = orderData(oid);
          return o.open == true && o.get('stage', 'open') != 'delivered' &&
            (o.get('lockAt', null) == null || request.time.toMillis() < o.lockAt);
        }
        function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
        // everyone who joined the order can see who's in and what they ordered
        allow read: if signedIn() && (pid == me() || isHost() ||
          exists(/databases/$(database)/documents/orders/$(oid)/people/$(me())));
        allow create: if signedIn() && (
          (isHost() && (pid == me() || request.resource.data.get('noApp', false) == true)) ||
          (pid == me() && isOpen() && request.resource.data.keys().hasOnly(['uid', 'name', 'items', 'joinedAt', 'updatedAt'])));
        // hosts can change anyone's food, prices and notes, and tick paid / got food
        allow update: if signedIn() && (isHost() ||
          (pid == me() && isOpen() && changed().hasOnly(['name', 'items', 'updatedAt'])) ||
          (pid == me() && changed().hasOnly(['paid'])));
        allow delete: if signedIn() && (isHost() || (pid == me() && isOpen()));
      }

      // Lamma Dash: everyone in the order sees the leaderboard; each saves only their own best score
      match /scores/{sid} {
        allow read: if signedIn() && (memberOf(oid) || hostOf(oid));
        allow create, update: if signedIn() && sid == me() && (memberOf(oid) || hostOf(oid)) && !deliveredOrder(oid)
          && request.resource.data.keys().hasOnly(['name', 'best', 'at'])
          && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best < 100000;
        allow delete: if signedIn() && hostOf(oid);
      }

      // Guess the Check: guesses stay hidden from other players until the order is delivered; hosts don't play
      match /guesses/{gid} {
        allow read: if signedIn() && (gid == me() || hostOf(oid) || (memberOf(oid) && deliveredOrder(oid)));
        allow create, update: if signedIn() && gid == me() && memberOf(oid) && !hostOf(oid) && !deliveredOrder(oid)
          && request.resource.data.keys().hasOnly(['name', 'guess', 'at'])
          && request.resource.data.guess is number && request.resource.data.guess >= 0;
        allow delete: if signedIn() && hostOf(oid);
      }
    }
  }
}
